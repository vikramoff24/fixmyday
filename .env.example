# ─────────────────────────────────────────────────────────────
# FixMyDay environment variables
# Copy to `.env.local` and fill in values. Never commit real secrets.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string (Neon recommended).
# For Neon, use the *pooled* connection string, e.g.
#   postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/fixmyday?sslmode=require
# Locally, any Postgres works:
#   postgresql://postgres:postgres@localhost:5432/fixmyday
DATABASE_URL=

# Clerk authentication — https://dashboard.clerk.com → API keys.
# Required in production. In local development, leaving both empty runs the app
# as a single local "dev user" so you can work without a Clerk account.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# OpenAI — server-side only, never exposed to the browser.
# Optional in development: without a key, FixMyDay uses its built-in offline
# planner so the full flow still works (with simpler language understanding).
OPENAI_API_KEY=
# Model used for planning and the assistant. Must support structured outputs.
OPENAI_MODEL=gpt-5-mini
